#!/bin/sh
# labagentd — canale di verifica su /dev/ttyS1.
#
# Perche' una seconda seriale e non comandi iniettati nel terminale visibile:
# se l'utente e' dentro `less`, `vi` o `top`, un comando iniettato finisce nel
# buffer dell'editor e gli distrugge il lavoro. Qui il terminale dell'utente
# (ttyS0) non viene MAI toccato.
#
# Protocollo asimmetrico:
#   host -> guest   "<id> <op> [arg ...]"     (token separati da spazio: parsare JSON in ash e' masochismo)
#   guest -> host   una riga JSON             (printf lo produce facile, JS lo legge gratis)

DEV=/dev/ttyS1
LIB=/opt/lab/lib/labcheck.sh
STATE=/opt/lab/state
LAB=/root/lab

mkdir -p "$STATE"
stty -F "$DEV" 115200 raw -echo 2>/dev/null

# Escaping JSON. Tre trappole, tutte pagate sul campo:
#  1. una TABULAZIONE letterale dentro una stringa JSON e' NON VALIDA. Il crontab
#     di default di Alpine e' scritto con i tab: bastava leggerlo perche' la
#     risposta diventasse impossibile da interpretare, la riga venisse scartata in
#     silenzio e la richiesta restasse appesa fino al timeout. (Successo davvero:
#     l'ha causato la riga di diagnostica aggiunta per capire un altro guasto.)
#  2. troncare DOPO aver sfuggito puo' tagliare a meta' una sequenza \n e lasciare
#     una barra sola in fondo: altra stringa non valida. Si tronca prima, sul grezzo.
#  3. un byte UTF-8 spezzato dal troncamento fa lo stesso danno: si tiene solo
#     ASCII stampabile. Sono messaggi di diagnostica, non prosa.
_esc() {
    head -c 3000 \
        | tr -cd '\11\12\40-\176' \
        | tr '\11' ' ' \
        | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
        | sed -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g'
}

reply() { # reply <id> <code> <out>
    printf '{"id":%s,"ok":%s,"code":%s,"out":"%s"}\n' \
        "$1" "$([ "$2" -eq 0 ] && echo true || echo false)" "$2" \
        "$(printf '%s' "$3" | _esc)" > "$DEV"
}

# esegue uno script del laboratorio con l'ambiente giusto
run_lab() { # run_lab <script>
    [ -f "$1" ] || { echo "script assente: $1"; return 127; }
    # HOME va impostato esplicitamente: labagentd nasce da init e non lo eredita.
    # Senza, uno script dell'utente che scrive in ~/lab finisce in /lab e fallisce
    # solo durante la verifica — un modo perfetto per impazzire.
    # </dev/null NON e' un dettaglio: il ciclo di questo agente legge da /dev/ttyS1,
    # e senza redirezione ogni script erediterebbe QUELLA seriale come stdin. Basta
    # un comando che legga stdin per divorare la riga di controllo successiva:
    # l'agente resta in attesa di qualcosa che e' gia' stato mangiato, e la verifica
    # va in timeout senza un motivo visibile. (E' successo: ch14.e2 in CI.)
    # `timeout` non e' pignoleria: se uno script si blocca (e uno script scritto da
    # chi studia PUO' bloccarsi) senza cane da guardia l'agente resta muto per
    # sempre, la verifica va in timeout lato browser e il laboratorio sembra morto
    # senza dire perche'. Cosi' invece risponde, e dice cosa e' successo.
    out=$(HOME=/root EDU_SEED="$(cat "$STATE/seed" 2>/dev/null || echo 1)" LAB="$LAB" \
        timeout "${LAB_TIMEOUT:-90}" sh -c ". $LIB; . '$1'" </dev/null 2>&1)
    rc=$?
    printf '%s' "$out"
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 143 ]; then
        printf '\nEDU CHECK watchdog FAIL got=bloccato want=uno script che termina\n'
        printf 'EDU RESULT 0/1\n'
    fi
    return $rc
}

printf '{"ev":"ready","v":1}\n' > "$DEV"

while IFS= read -r line; do
    [ -z "$line" ] && continue
    # shellcheck disable=SC2086
    set -- $line
    id=$1; op=$2; shift 2
    case "$op" in
        ping)
            reply "$id" 0 "pong"
            ;;
        # seed <dir> <seme> : prepara il mondo dell'esercizio.
        # L'area di lavoro si azzera SEMPRE prima del seed: altrimenti i resti
        # dell'esercizio (o del seme) precedente falsano la verifica, e un trucco
        # puo' passare grazie a un file rimasto li' per sbaglio.
        seed)
            # NON `rm -rf "$LAB"`: se la shell dell'utente e' dentro quella cartella,
            # cancellarla lo lascia in una directory che non esiste piu' e ogni `ls`
            # risponde "cannot open directory '.'". (E' proprio il fenomeno che il
            # capitolo 2 spiega nella parte PRO — sarebbe grottesco causarlo noi.)
            # Si svuota il contenuto e si tiene l'inode.
            mkdir -p "$LAB" "$STATE"
            # Prima di svuotare: smontare quello che un esercizio precedente ha lasciato
            # montato dentro l'area di lavoro (il capitolo 13 monta un filesystem su loop
            # device) e staccare i loop. Senza, `rm -rf` non riesce a svuotare e la
            # macchina si trascina mount e memoria per tutti i 60 esercizi: a un certo
            # punto qualcosa smette di funzionare, in un punto che sembra scollegato
            # dalla causa. (E' successo: il capitolo 14 falliva in CI per colpa del 13.)
            for m in $(awk -v l="$LAB" 'index($2, l) == 1 {print $2}' /proc/mounts 2>/dev/null | sort -r); do
                umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null
            done
            losetup -D 2>/dev/null
            find "$LAB" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
            # via ogni traccia dell'esercizio precedente: risposte consegnate,
            # valori memorizzati dal seed, tutto. Resta solo il seme, che scriviamo ora.
            find "$STATE" -maxdepth 1 -type f ! -name current -delete 2>/dev/null
            printf '%s' "$2" > "$STATE/seed"
            out=$(run_lab "/opt/lab/$1/seed.sh"); reply "$id" $? "$out"
            ;;
        # check <dir> : verifica
        check)
            out=$(run_lab "/opt/lab/$1/check.sh"); reply "$id" $? "$out"
            ;;
        # solve <dir> : soluzione di riferimento (solo per i test, mai dalla UI)
        solve)
            out=$(run_lab "/opt/lab/$1/solution.sh"); reply "$id" $? "$out"
            ;;
        # reset <dir> : ricomincia da capo con lo STESSO seme
        reset)
            mkdir -p "$LAB"; find "$LAB" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
            rm -f "$STATE/answer"
            out=$(run_lab "/opt/lab/$1/seed.sh"); reply "$id" $? "$out"
            ;;
        write)
            p=$1; m=$2; mkdir -p "$(dirname "$p")"
            printf '%s' "$3" | base64 -d > "$p" 2>/dev/null
            rc=$?; chmod "$m" "$p" 2>/dev/null; reply "$id" $rc ""
            ;;
        sh)
            out=$(cd "$LAB" 2>/dev/null; HOME=/root sh -c "$*" </dev/null 2>&1); reply "$id" $? "$out"
            ;;
        *)
            reply "$id" 127 "operazione sconosciuta: $op"
            ;;
    esac
done < "$DEV"

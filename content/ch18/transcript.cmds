#nota La tabella dei cartelli. La riga default e' il gateway: senza, si parla solo con i vicini. | The signpost table. The default line is the gateway: without it, you only talk to neighbours.
ip route
#nota Invece di leggere la tabella e ragionare, si chiede al kernel cosa farebbe. | Instead of reading the table and reasoning, you ask the kernel what it would do.
ip route get 1.1.1.1
#nota Anche per il loopback: interfaccia, indirizzo sorgente, tutto esplicito. | For loopback too: interface, source address, all explicit.
ip route get 127.0.0.1
#nota Chi risolve i nomi. Spesso questo file e' GENERATO: modificarlo a mano dura fino al prossimo rinnovo DHCP. | Who resolves names. This file is often GENERATED: editing it by hand lasts until the next DHCP renewal.
cat /etc/resolv.conf
#nota Un riepilogo dei socket: quante connessioni, in che stato. | A socket summary: how many connections, in which states.
ss -s
